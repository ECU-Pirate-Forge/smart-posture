# Created by venv; see https://docs.python.org/3/library/venv.html
*
!.gitignore
smart_posture_venv/

# Explicitly version the core integration additions despite the legacy
# catch-all rule above.
!skeleton.py
!run_pose.py
!requirements.txt
!tests/
!tests/test_smart_posture.py

# The maintained 3D visualizers are also source files, while their generated
# images and cache files remain ignored.
!3dRender/
3dRender/*
!3dRender/skeleton_3d.py
!files/
files/*
!files/visualization_3d/
files/visualization_3d/*
!files/visualization_3d/renderer_3d.py
